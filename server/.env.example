NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# If you have a real MongoDB (local install or Atlas), set it here.
# Leave empty in dev to auto-start an in-memory MongoDB (data resets on restart).
MONGODB_URI=

JWT_SECRET=change_this_super_secret_key_horizon360
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_super_secret_refresh_key_horizon360
JWT_REFRESH_EXPIRES_IN=30d

COMPANY_NAME=Horizon360
COMPANY_CURRENCY=FCFA
